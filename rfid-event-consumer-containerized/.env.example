# Copy to .env and fill in real values. Do NOT commit .env with real secrets.

# Required
SERVICEBUS_CONNECTION_STR=Endpoint=sb://sbns-signal-to-system-dev.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
TABLE_CONNECTION_STR=DefaultEndpointsProtocol=https;AccountName=sasignaltosystemdev;AccountKey=...;EndpointSuffix=core.windows.net

# Optional (defaults shown)
QUEUE_NAME=rfid-events
TABLE_NAME=rfidevents
